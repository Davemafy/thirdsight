# Server-side only. Never put these values in browser code.
THIRDSIGHT_SUPABASE_URL=https://your-project.supabase.co
THIRDSIGHT_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
THIRDSIGHT_INGESTION_TOKEN=replace-with-random-installation-token
THIRDSIGHT_ENVIRONMENT=demo

# Generic managed HTTP gateway.
THIRDSIGHT_GATEWAY_API_KEY=replace-with-32-byte-merchant-gateway-key

# Optional real/test upstream credentials. Configure only integrations you route live.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
MONNIFY_ACCESS_TOKEN=
SENDBOX_ACCESS_TOKEN=
KWIK_API_KEY=
TERMII_API_KEY=
SENDCHAMP_ACCESS_KEY=
META_CAPI_ACCESS_TOKEN=
GA4_API_SECRET=
THIRDSIGHT_KWIK_UPSTREAM_ORIGIN=

# CEDAR Commerce Lab managed receiver.
PARTNER_MANAGED_ORIGIN=https://your-partner-lab.example
PARTNER_MANAGED_TOKEN=replace-with-32-byte-partner-managed-token

# Legacy signed CEDAR proof path retained for historical challenge scenarios.
CEDAR_INTEGRATION_SECRET=replace-with-32-byte-secret
CEDAR_COMMERCE_URL=http://localhost:3000
PARTNER_ANALYTICS_URL=http://localhost:3001/ingest/analytics
PARTNER_ADVERTISING_URL=http://localhost:3001/ingest/advertising
PARTNER_CRM_URL=http://localhost:3001/ingest/crm
PARTNER_GATEWAY_SECRET=replace-with-32-byte-secret
