# Server-side only. Never put these values in the browser extension source.
THIRDSIGHT_SUPABASE_URL=https://your-project.supabase.co
THIRDSIGHT_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
THIRDSIGHT_INGESTION_TOKEN=replace-with-random-installation-token
THIRDSIGHT_ENVIRONMENT=demo

# CEDAR managed gateway (server-side only)
CEDAR_INTEGRATION_SECRET=replace-with-32-byte-secret
CEDAR_COMMERCE_URL=http://localhost:3000
PARTNER_ANALYTICS_URL=http://localhost:3001/ingest/analytics
PARTNER_ADVERTISING_URL=http://localhost:3001/ingest/advertising
PARTNER_CRM_URL=http://localhost:3001/ingest/crm
PARTNER_GATEWAY_SECRET=replace-with-32-byte-secret
