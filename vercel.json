{
  "rewrites": [
    {
      "source": "/api/control-plane",
      "destination": "/api/console-events?controlPlane=1"
    },
    {
      "source": "/api/managed-gateway",
      "destination": "/api/console-events?managedHttpGateway=1"
    },
    {
      "source": "/api/gateway/v1/dispatch",
      "destination": "/api/console-events?managedGateway=1"
    },
    {
      "source": "/commerce-lab",
      "destination": "/index.html"
    },
    {
      "source": "/commerce-lab/:path*",
      "destination": "/index.html"
    }
  ]
}
